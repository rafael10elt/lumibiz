import { Lightbulb, Handshake, Cog, MapPin, MessageCircle, Edit, Trash2, FolderOpen } from 'lucide-react';
import { type Cliente } from '../../hooks/useLumiBiz';
import { useAuth } from '../../contexts/AuthContext';

interface ClienteCardProps {
  cliente: Cliente;
}

export function ClienteCard({ cliente }: ClienteCardProps) {
  const { perfil } = useAuth();
  const isAdmin = perfil?.role === 'admin';

  // Define o ícone e a cor baseado na categoria
  const renderCategoryIcon = () => {
    switch (cliente.categoria) {
      case 'Lead': return <Lightbulb size={20} className="text-yellow-500" />;
      case 'Contrato': return <Handshake size={20} className="text-blue-500" />;
      case 'Serviço': return <Cog size={20} className="text-purple-500" />;
      default: return null;
    }
  };

  const statusColor = cliente.status === 'ativo' || cliente.status === 'Ativo' ? 'bg-green-500' : 'bg-red-500';

  return (
    <div className="relative bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-5 flex flex-col items-center text-center hover:shadow-md transition-shadow">
      
      {/* Ícone de Categoria (Topo Esquerda) */}
      <div className="absolute top-3 left-3">
        {renderCategoryIcon()}
      </div>

      {/* Bolinha de Status (Topo Direita) */}
      <div 
        className={`absolute top-4 right-4 h-3 w-3 rounded-full ${statusColor}`} 
        title={`Status: ${cliente.status}`}
      />

      {/* Avatar/Logo do Cliente */}
      <img 
        src={cliente.foto_url || `https://ui-avatars.com/api/?name=${cliente.nome}&background=f3f4f6&color=373737`} 
        alt={cliente.nome} 
        className="w-20 h-20 rounded-xl object-cover mb-4 shadow-sm border border-gray-100 dark:border-gray-600"
      />

      {/* Info */}
      <h4 className="font-bold text-lg text-gray-800 dark:text-white leading-tight mb-1">{cliente.nome}</h4>
      <p className="text-sm text-gray-500 dark:text-gray-400 mb-4">
        Resp: {cliente.responsavel || 'Não informado'}
      </p>

      {/* Ações */}
      <div className="flex items-center justify-center space-x-3 mt-auto pt-4 border-t border-gray-100 dark:border-gray-700 w-full">
        {cliente.telefone && (
          <a href={`https://wa.me/${cliente.telefone.replace(/\D/g, '')}`} target="_blank" rel="noreferrer" className="text-green-500 hover:text-green-600 bg-green-50 p-2 rounded-full dark:bg-green-900/20">
            <MessageCircle size={18} />
          </a>
        )}
        
        {cliente.endereco && (
          <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(cliente.endereco)}`} target="_blank" rel="noreferrer" className="text-blue-500 hover:text-blue-600 bg-blue-50 p-2 rounded-full dark:bg-blue-900/20">
            <MapPin size={18} />
          </a>
        )}

        <button className="text-gray-500 hover:text-gray-700 bg-gray-50 p-2 rounded-full dark:bg-gray-700 dark:text-gray-300" title="Ver Documentos">
          <FolderOpen size={18} />
        </button>

        {isAdmin && (
          <>
            <button className="text-brand-gold hover:text-[#a68a5a] bg-yellow-50 p-2 rounded-full dark:bg-yellow-900/20" title="Editar Cliente">
              <Edit size={18} />
            </button>
            <button className="text-red-500 hover:text-red-600 bg-red-50 p-2 rounded-full dark:bg-red-900/20" title="Apagar Cliente">
              <Trash2 size={18} />
            </button>
          </>
        )}
      </div>
    </div>
  );
}
