                          <button onClick={() => excluirValidade(item.id)} className="text-red-500 hover:text-red-600">
                            Excluir
                          </button>
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
