import { useState } from 'react';
import { Search, Plus } from 'lucide-react';
import { useClientes } from '../../hooks/useLumiBiz';
import { ClienteCard } from './ClienteCard';
import { useAuth } from '../../contexts/AuthContext';
import { cn } from '../../lib/utils';

export function ClientesPage() {
  const { perfil } = useAuth();
  const { data: clientes, isLoading, isError } = useClientes();
  
  // Estados para os filtros
  const [searchTerm, setSearchTerm] = useState('');
  const [statusFilter, setStatusFilter] = useState('Todos');
  const[categoryFilter, setCategoryFilter] = useState('Todos');

  const isAdmin = perfil?.role === 'admin';

  // Lógica de Filtro
  const filteredClientes = clientes?.filter(c => {
    const matchName = c.nome.toLowerCase().includes(searchTerm.toLowerCase());
    
    // Normalizando a string para evitar erros de maiúscula/minúscula (Ativo vs ativo)
    const normalizedStatus = c.status ? c.status.toLowerCase() : 'ativo';
    const matchStatus = statusFilter === 'Todos' || normalizedStatus === statusFilter.toLowerCase();
    
    const matchCategory = categoryFilter === 'Todos' || c.categoria === categoryFilter;
    
    return matchName && matchStatus && matchCategory;
  });

  if (isLoading) {
    return <div className="flex justify-center items-center h-64"><div className="animate-spin rounded-full h-12 w-12 border-b-2 border-brand-gold"></div></div>;
  }

  if (isError) {
    return <div className="text-red-500 text-center p-4">Erro ao carregar clientes.</div>;
  }

  return (
    <div className="space-y-6">
      
      {/* Controles: Busca, Filtros e Botão Novo */}
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        
        {/* Barra de Busca */}
        <div className="relative w-full max-w-xs">
          <input 
            type="text" 
            placeholder="Buscar cliente..." 
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="w-full pl-10 pr-4 py-2 bg-white border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-gold dark:bg-gray-800 dark:border-gray-700 dark:text-white"
          />
          <Search className="absolute left-3 top-2.5 text-gray-400" size={18} />
        </div>

        {/* Grupo de Filtros e Botão */}
        <div className="flex flex-wrap items-center gap-3 w-full sm:w-auto">
          
          {/* Filtro de Status */}
          <div className="flex bg-gray-200 dark:bg-gray-700 p-1 rounded-lg">
            {['Todos', 'Ativo', 'Inativo'].map(status => (
              <button
                key={status}
                onClick={() => setStatusFilter(status)}
                className={cn(
                  "px-3 py-1.5 text-sm font-medium rounded-md transition-colors",
                  statusFilter === status 
                    ? "bg-brand-gold text-white shadow-sm" 
                    : "text-gray-600 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600"
                )}
              >
                {status}
              </button>
            ))}
          </div>

          {/* Filtro de Categoria (Só para Admin no sistema legado, mantivemos a regra) */}
          {isAdmin && (
            <div className="hidden md:flex bg-gray-200 dark:bg-gray-700 p-1 rounded-lg">
              {['Todos', 'Contrato', 'Lead', 'Serviço'].map(cat => (
                <button
                  key={cat}
                  onClick={() => setCategoryFilter(cat)}
                  className={cn(
                    "px-3 py-1.5 text-sm font-medium rounded-md transition-colors",
                    categoryFilter === cat 
                      ? "bg-brand-gold text-white shadow-sm" 
                      : "text-gray-600 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600"
                  )}
                >
                  {cat}
                </button>
              ))}
            </div>
          )}

          {/* Botão Novo Cliente */}
          {isAdmin && (
            <button 
              onClick={() => alert('Modal de Novo Cliente será implementado na próxima etapa!')}
              className="flex items-center gap-2 bg-brand-dark text-white px-4 py-2 rounded-lg hover:bg-brand-gold transition-colors ml-auto sm:ml-0"
            >
              <Plus size={18} />
              <span>Novo</span>
            </button>
          )}
        </div>
      </div>

      {/* Grid de Cartões */}
      {filteredClientes?.length === 0 ? (
        <div className="text-center py-12 text-gray-500 bg-white dark:bg-gray-800 rounded-xl border border-dashed border-gray-300 dark:border-gray-700">
          Nenhum cliente encontrado para estes filtros.
        </div>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
          {filteredClientes?.map(cliente => (
            <ClienteCard key={cliente.id} cliente={cliente} />
          ))}
        </div>
      )}

    </div>
  );
}
</file>

<file path="src/pages/Dashboard/DashboardPage.tsx">
import { useMemo } from 'react';
import { useChamados, useClientes, useCustos, useReceitas, useRequisicoes, useVisitas } from '../../hooks/useLumiBiz';

export function DashboardPage() {
  const { data: clientes } = useClientes();
  const { data: visitas } = useVisitas();
  const { data: requisicoes } = useRequisicoes();
  const { data: chamados } = useChamados();
  const { data: receitas } = useReceitas();
  const { data: custos } = useCustos();

  const cards = useMemo(() => {
    const totalReceitas = (receitas || []).reduce((acc, item) => acc + Number(item.valor || 0), 0);
    const totalCustos = (custos || []).reduce((acc, item) => acc + Number(item.valor || 0), 0);
    const saldo = totalReceitas - totalCustos;

    return [
      { label: 'Clientes', value: String((clientes || []).length) },
      { label: 'Visitas', value: String((visitas || []).length) },
      { label: 'Requisicoes em aberto', value: String((requisicoes || []).filter((r) => r.status === 'aberta').length) },
      { label: 'Chamados em aberto', value: String((chamados || []).filter((c) => c.status === 'aberto').length) },
      { label: 'Receitas', value: `R$ ${totalReceitas.toFixed(2)}` },
      { label: 'Custos', value: `R$ ${totalCustos.toFixed(2)}` },
      { label: 'Saldo', value: `R$ ${saldo.toFixed(2)}` },
    ];
  }, [clientes, visitas, requisicoes, chamados, receitas, custos]);

  return (
    <div className="space-y-4">
      <div>
        <h2 className="text-xl font-semibold text-gray-900 dark:text-white">Visao geral</h2>
        <p className="text-sm text-gray-500 dark:text-gray-400">Indicadores em tempo real do seu tenant.</p>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {cards.map((card) => (
          <div key={card.label} className="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
            <p className="text-sm text-gray-500 dark:text-gray-400">{card.label}</p>
            <p className="text-2xl font-semibold text-brand-dark dark:text-white mt-1">{card.value}</p>
          </div>
        ))}
      </div>
    </div>
  );
}
