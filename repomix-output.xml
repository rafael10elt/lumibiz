        <div className="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
          <p className="text-sm text-gray-500">Custos</p>
          <p className="text-xl font-semibold text-red-600">R$ {totais.totalCustos.toFixed(2)}</p>
        </div>
        <div className="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
          <p className="text-sm text-gray-500">Saldo</p>
          <p className="text-xl font-semibold text-brand-gold">R$ {totais.saldo.toFixed(2)}</p>
        </div>
      </div>

      <div className="flex bg-gray-200 dark:bg-gray-700 p-1 rounded-lg w-fit">
        <button
          onClick={() => setAba('receitas')}
          className={`px-4 py-1.5 rounded-md text-sm ${aba === 'receitas' ? 'bg-brand-gold text-white' : 'text-gray-700 dark:text-gray-300'}`}
        >
          Receitas
