import { useMemo, useState } from 'react';
import { useCustos, useReceitas } from '../../hooks/useLumiBiz';

type AbaFinanceiro = 'receitas' | 'custos';

export function FinanceiroPage() {
  const [aba, setAba] = useState<AbaFinanceiro>('receitas');
  const { data: receitas, isLoading: loadingReceitas, isError: erroReceitas, error: errorReceitas } = useReceitas();
  const { data: custos, isLoading: loadingCustos, isError: erroCustos, error: errorCustos } = useCustos();

  const totais = useMemo(() => {
    const totalReceitas = (receitas || []).reduce((acc, item) => acc + Number(item.valor || 0), 0);
    const totalCustos = (custos || []).reduce((acc, item) => acc + Number(item.valor || 0), 0);
    return { totalReceitas, totalCustos, saldo: totalReceitas - totalCustos };
  }, [receitas, custos]);

  const loading = aba === 'receitas' ? loadingReceitas : loadingCustos;
  const isError = aba === 'receitas' ? erroReceitas : erroCustos;
