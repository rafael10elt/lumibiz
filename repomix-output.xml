import { VisitaCard } from './VisitaCard';
import type { VisitaComRelacionamentos } from '../../hooks/useLumiBiz';

interface VisitasKanbanProps {
  visitas: VisitaComRelacionamentos[];
  onUpdate: () => void;
}

const KanbanColumn = ({ title, visitas, onUpdate }: { title: string, visitas: VisitaComRelacionamentos[], onUpdate: () => void }) => (
  <div className="bg-gray-200 dark:bg-gray-800 rounded-lg p-3 flex-shrink-0 w-full sm:w-80">
    <h3 className="font-bold text-lg mb-4 text-gray-800 dark:text-white px-1">
      {title} <span className="text-gray-500 font-medium">({visitas.length})</span>
    </h3>
    <div className="space-y-4 h-full overflow-y-auto">
      {visitas.length > 0 ? (
        visitas.map(visita => <VisitaCard key={visita.id} visita={visita} onUpdate={onUpdate} />)
      ) : (
        <p className="text-center text-sm text-gray-500 py-4">Nenhuma visita nesta etapa.</p>
      )}
    </div>
  </div>
);

export function VisitasKanban({ visitas, onUpdate }: VisitasKanbanProps) {
  const agendadas = visitas.filter(v => v.status === 'Agendada');
  const emAndamento = visitas.filter(v => v.status === 'Em Andamento');
  const concluidas = visitas.filter(v => v.status === 'Concluída');

  return (
    // No mobile (padrão), é uma coluna. Em telas maiores, vira uma linha com scroll horizontal.
    <div className="flex flex-col lg:flex-row gap-6 lg:overflow-x-auto pb-4">
      <KanbanColumn title="Agendada" visitas={agendadas} onUpdate={onUpdate} />
      <KanbanColumn title="Em Andamento" visitas={emAndamento} onUpdate={onUpdate} />
      <KanbanColumn title="Concluída" visitas={concluidas} onUpdate={onUpdate} />
    </div>
  );
}
